# Pactora environment. Everything is optional: with nothing set the app runs in
# practice mode on seed data from lib/data.ts.

# QuorumPool address on Aevum testnet. Printed by `forge script script/Deploy.s.sol` (see contracts/README.md).
# Setting it switches the UI and /api/relay to the live path.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Aevum testnet chain id (QDay docs / starter kit). Default 44005.
NEXT_PUBLIC_CHAIN_ID=44005

# Aevum testnet RPC (QDay docs). Default https://rpc-test.qday.info
NEXT_PUBLIC_AEVUM_RPC=https://rpc-test.qday.info

# Aevum block explorer base URL, used for tx and address links. Confirm the current URL in the QDay Discord.
NEXT_PUBLIC_EXPLORER_URL=https://explorer-test.qday.info

# tUSD8 token address and decimals (qday-io/aevum-starter-kit README). Verify decimals with `cast call <addr> "decimals()"`.
NEXT_PUBLIC_TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483
NEXT_PUBLIC_TUSD8_DECIMALS=6

# Public site URL for metadata and OG tags. Your Vercel domain.
NEXT_PUBLIC_SITE_URL=https://pactora.vercel.app

# Server only. Testnet key of the gasless relayer that submits pledge, cancel and settle.
# Fund it with tQDAY from faucet.qday.info (or /faucet in the QDay Discord). Add it in Vercel project env, never commit it.
RELAYER_PRIVATE_KEY=
