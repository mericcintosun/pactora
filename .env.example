# Pactora environment. Everything is optional: with nothing set the app runs in
# practice mode on seed data from lib/data/seed.ts. lib/config.ts is the single
# place these are read (ADAPTER_MODE in lib/adapter/index.ts, RELAYER_PRIVATE_KEY
# in lib/relayer.ts, both named in lib/config.ts).

# Data adapter for pages and /api/campaigns: "fake" (seed data, default) or exactly "real".
# "real" only takes effect when NEXT_PUBLIC_CONTRACT_ADDRESS is also set; otherwise the site stays on seed data.
# Where it comes from: the farm runner sets it on Vercel once RELAYER_PRIVATE_KEY is held.
ADAPTER_MODE=fake

# QuorumPool address on Aevum testnet. Printed by `forge script script/Deploy.s.sol`;
# the farm's deploy step writes it here (see contracts/README.md). Read as POOL_ADDRESS.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Aevum testnet chain id (QDay docs / starter kit). Default 44005.
NEXT_PUBLIC_CHAIN_ID=44005

# Aevum testnet RPC (QDay docs). Default https://rpc-test.qday.info
NEXT_PUBLIC_AEVUM_RPC=https://rpc-test.qday.info

# Aevum block explorer base URL, used for tx and address links. Confirm the current URL in the QDay Discord.
NEXT_PUBLIC_EXPLORER_URL=https://explorer-test.qday.info

# tUSD8 token address and decimals (qday-io/aevum-starter-kit README). `npm run proof` reads decimals() on chain.
NEXT_PUBLIC_TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483
NEXT_PUBLIC_TUSD8_DECIMALS=6

# Public site URL for metadata and OG tags. Your Vercel domain.
NEXT_PUBLIC_SITE_URL=https://pactora-smoky.vercel.app

# Filled at build time by next.config.ts from public/brand/*.png. Leave empty.
NEXT_PUBLIC_BRAND_FILES=

# Server only, secret. Testnet key (0x + 64 hex) of the gasless relayer that submits pledge, cancel and settle.
# Where it comes from: a fresh testnet wallet funded with about 2 tQDAY from faucet.qday.info
# (or /faucet in the QDay Discord). Add it in Vercel project env only, never commit it, never prefix it NEXT_PUBLIC_.
RELAYER_PRIVATE_KEY=

# Timeouts, retry count, rate limit and log lookback are constants in lib/config.ts, not env.
